# OpenRouter API Key (primary)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxx

# Hugging Face API Key (fallback) - Get from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxx

# Model chain - OpenRouter free models
MODEL_FALLBACK_CHAIN=google/gemini-2.0-flash-lite,meta-llama/llama-3.2-3b-instruct,mistralai/mistral-7b-instruct

# Hugging Face models to try (optional, override if needed)
# HUGGINGFACE_MODELS=google/gemma-2-2b-it,microsoft/phi-2

# App settings
APP_URL=http://localhost:3000
VELARIS_DB_PATH=velaris.db

# Module 1 — type classifier (optional overrides; defaults to
# backend/ml/checkpoints/ if you leave these unset)
# TYPE_CLASSIFIER_CHECKPOINT=backend/ml/checkpoints/type_classifier.pt
# TYPE_CLASSIFIER_CLASSES=backend/ml/checkpoints/class_to_idx.json

# Module 2 — style classifier (optional overrides)
# STYLE_CLASSIFIER_CHECKPOINT=backend/ml/checkpoints/style_classifier.pt
# STYLE_CLASSIFIER_CLASSES=backend/ml/checkpoints/style_class_to_idx.json

# Module 3 — gemstone detector (optional overrides)
# GEMSTONE_DETECTOR_WEIGHTS=backend/ml/checkpoints/gemstone_detector.pt
# GEMSTONE_DETECTOR_CONF=0.35

# Module 4 — similarity search (optional overrides)
# SIMILARITY_INDEX_EMBEDDINGS=backend/ml/checkpoints/similarity_embeddings.npy
# SIMILARITY_INDEX_METADATA=backend/ml/checkpoints/similarity_metadata.json
